# Public Supabase settings. These are safe to expose in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
REMINDER_JOB_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# The VAPID public key is used by the browser for PushManager.subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
